rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin(companyCode) {
      return isSignedIn() && getUserData(request.auth.uid).role == 'admin' && getUserData(request.auth.uid).companyCode == companyCode;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
               data.uid == request.auth.uid &&
               data.role in ['admin', 'worker'] &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email == request.auth.token.email;
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || getUserData(request.auth.uid).companyCode == existing().companyCode);
      allow list: if isSignedIn() && getUserData(request.auth.uid).companyCode == resource.data.companyCode;
      
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && (
        // Only allow updating companyCode if not set or joining
        (incoming().diff(existing()).affectedKeys().hasOnly(['companyCode'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['name']))
      );
    }

    // --- Companies ---
    match /companies/{code} {
      function isValidCompany(data) {
        return data.keys().hasAll(['code', 'adminUid', 'name', 'createdAt']) &&
               data.code == code &&
               data.adminUid == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCompany(incoming()) && isValidId(code);
    }

    // --- Attendance ---
    match /attendance/{recordId} {
      function isValidAttendance(data) {
        return data.keys().hasAll(['userId', 'companyCode', 'date', 'status', 'updatedAt']) &&
               data.userId is string && data.userId.size() <= 128 &&
               data.companyCode is string && data.companyCode.size() <= 50 &&
               data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
               data.status in ['Present', 'Absent'] &&
               data.updatedAt == request.time;
      }

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        getUserData(request.auth.uid).role == 'admin' && getUserData(request.auth.uid).companyCode == resource.data.companyCode
      );

      allow create: if isSignedIn() && 
                    isValidAttendance(incoming()) && 
                    incoming().userId == request.auth.uid &&
                    incoming().companyCode == getUserData(request.auth.uid).companyCode;

      allow update: if isSignedIn() && (
        // Admin override
        (getUserData(request.auth.uid).role == 'admin' && 
         getUserData(request.auth.uid).companyCode == existing().companyCode &&
         incoming().diff(existing()).affectedKeys().hasAll(['status', 'editedByAdmin', 'updatedAt']) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'editedByAdmin', 'updatedAt', 'method', 'time'])) // Admin might set status
      ) || (
        // Worker update (e.g. marking present later in the day if allowed, though usually it's a create)
        existing().userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'time', 'location', 'method', 'updatedAt'])
      );
    }

    // --- Messages ---
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['senderId', 'receiverId', 'companyCode', 'text', 'timestamp']) &&
               data.senderId == request.auth.uid &&
               data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
               data.timestamp == request.time;
      }

      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      
      allow create: if isSignedIn() && isValidMessage(incoming());
    }
  }
}
